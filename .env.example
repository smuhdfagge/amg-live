APP_NAME="SWATCH"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://swatch.org.ng

APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@swatch.org.ng"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# SWATCH settings
# ------------------------------------------------------------------

# First admin account, created by "php artisan db:seed".
# Sign in at /admin and change the password straight away.
ADMIN_NAME="SWATCH Admin"
ADMIN_EMAIL=admin@swatch.org.ng
ADMIN_PASSWORD="ChangeMe@2026"

# Where website form notifications go.
SWATCH_NOTIFY_EMAIL=swatchngo2002@gmail.com

# Contact details shown on the website.
SWATCH_PHONE="0803 787 3565"
SWATCH_PHONE_LINK=+2348037873565
SWATCH_EMAIL=swatchngo2002@gmail.com
SWATCH_EMAIL_ALT=ramatutuwa@gmail.com

# Social profiles. Leave empty to hide the icon.
SWATCH_FACEBOOK=
SWATCH_X=
SWATCH_INSTAGRAM=
SWATCH_LINKEDIN=
SWATCH_YOUTUBE=

# Bank details for direct gifts. The Support page shows them only
# when the account number is filled in.
SWATCH_BANK_ACCOUNT_NAME=
SWATCH_BANK_ACCOUNT_NUMBER=
SWATCH_BANK_NAME=
