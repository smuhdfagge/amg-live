APP_NAME="AMG Foundation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://aminumagashigarbafoundation.org

APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@aminumagashigarbafoundation.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# AMG Foundation settings
# ------------------------------------------------------------------

# First admin account, created by "php artisan db:seed".
# Sign in at /admin and change the password straight away.
ADMIN_NAME="AMG Foundation Admin"
ADMIN_EMAIL=admin@aminumagashigarbafoundation.org
ADMIN_PASSWORD="ChangeMe@2026"

# Where website form notifications go.
AMG_NOTIFY_EMAIL=

# Contact details shown on the website. Leave a value empty to hide it.
# AMG_PHONE is how the number is shown; AMG_PHONE_LINK is the same number
# in international form for the tap-to-call link, e.g. +2348031234567.
AMG_PHONE=
AMG_PHONE_LINK=
AMG_EMAIL=
AMG_EMAIL_ALT=
AMG_HOURS=

# Registration details. Shown on the site only when filled in.
AMG_FOUNDED=
AMG_CAC=
AMG_TIN=

# Social profiles. Leave empty to hide the icon.
AMG_FACEBOOK=
AMG_X=
AMG_INSTAGRAM=
AMG_LINKEDIN=
AMG_YOUTUBE=

# Bank details for direct gifts. The Support page shows them only
# when the account number is filled in.
AMG_BANK_ACCOUNT_NAME=
AMG_BANK_ACCOUNT_NUMBER=
AMG_BANK_NAME=

# Largest files the admin can upload under Resources, in MB.
AMG_MAX_AUDIO_MB=50
AMG_MAX_VIDEO_MB=200
